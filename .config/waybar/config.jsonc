{
  "reload_style_on_change": true,
  "exclusive": true,
  "position": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 1,
  "margin-bottom": 0,
  "margin-right": 0,
  "margin-left": 0,

  "modules-left": [
    "group/left1",
    "group/left2",
    "group/left3",
    "group/left4"
  ],

  "group/left1": {
    "orientation": "inherit",
    "modules": ["custom/power"]
  },

  "group/left2": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },

  "group/left3": {
    "orientation": "inherit",
    "modules": [
      "idle_inhibitor",
      "group/tray-expander2"
    ]
  },

  "group/left4": {
    "orientation": "inherit",
    "modules": ["mpris"]
  },

  "modules-center": ["clock"],

  "modules-right": ["group/right1", "group/right"],

  "group/right1": {
    "orientation": "inherit",
    "modules": ["group/tray-expander"]
  },

  "group/right": {
    "orientation": "inherit",
    "modules": ["pulseaudio", "memory", "cpu", "battery"]
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "cursor": true,
    "format": "{icon}",
    "format-icons": {
      "default":  "󰝤",
      "active":   "",
      "empty":    "",
      "focused":  ""
    },
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": []
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated":   "",
      "deactivated": "󰾫"
    }
  },

  "clock": {
    "format": "{:%a %d ｜ %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month":    "<span color='#DCD7BA'><b>{}</b></span>",
        "weekdays": "<span color='#98BB6C'><b>{}</b></span>",
        "today":    "<span color='#E46876'><b>{}</b></span>"
      }
    }
  },

  "cpu": {
    "interval": 10,
    "format": "cpu {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "mem {used:0.1f}G",
    "on-click": "kitty -e btop"
  },

  "battery": {
    "format":            "bat {capacity}%",
    "format-discharging":"bat {capacity}%",
    "format-charging":   "bat {capacity}%",
    "format-plugged":    "bat_p {capacity}%",
    "format-full":       "bat_f {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default":  ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tooltip-format-discharging": "{power:>1.0f}W⇣ {capacity}%
 {timeTo}",
    "tooltip-format-charging":    "{power:>1.0f}W⇡ {capacity}%
 {timeTo}",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "network": {
    "format-icons":      ["󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"],
    "format":            "{icon}",
    "format-wifi":       "{icon}",
    "format-ethernet":   "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi":     "{essid} ({frequency} GHz)
⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format":           "󰂯",
    "format-disabled":  "󰂲",
    "format-connected": "󰂰",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format":       "vol {volume}%",
    "format-muted": "",
    "on-click":       "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "headset":   "",
      "default":   ["", "", ""]
    }
  },

  "mpris": {
    "format": "  {artist} - {title}",
    "format-paused": "<span color='grey'>{status_icon}  {title}</span>",
    "max-length": 75,
    "player-icons": {
      "default": "⏸",
      "mpv":     "🎵"
    },
    "status-icons": {
      "paused": "󰝛"
    },
    "ignored-players": ["firefox", "chromium", "brave"]
  },

  "custom/power": {
    "format": "",
    "on-click": "wlogout",
    "tooltip": false
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },

  "tray": {
    "icon-size": 11,
    "spacing": 5
  },

  "group/tray-expander2": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
      "transition-left-to-right": true
    },
    "modules": ["custom/expand-icon2", "bluetooth", "network"]
  },

  "custom/expand-icon2": {
    "format": "",
    "tooltip": false
  }
}
